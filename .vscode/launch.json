{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug MiniVulkanEngine (CodeLLDB)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/clang-debug/MiniVulkanEngine.exe",
      "cwd": "${workspaceFolder}/build/clang-debug",
      "preLaunchTask": "CMake: Build Debug",
      "stopOnEntry": false,
      "terminal": "integrated",
      "sourceLanguages": [
        "cpp"
      ]
    },
    {
      "name": "Run MiniVulkanEngine Release",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/clang-release/MiniVulkanEngine.exe",
      "cwd": "${workspaceFolder}/build/clang-release",
      "preLaunchTask": "CMake: Build Release",
      "stopOnEntry": false,
      "terminal": "integrated",
      "sourceLanguages": [
        "cpp"
      ]
    },
    {
      "name": "Run MiniVulkanEngine Publish",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/clang-publish/MiniVulkanEngine.exe",
      "cwd": "${workspaceFolder}/build/clang-publish",
      "preLaunchTask": "CMake: Package Publish Shaders",
      "stopOnEntry": false,
      "terminal": "integrated",
      "sourceLanguages": [
        "cpp"
      ]
    },
    {
      "name": "Debug MiniEditor (CodeLLDB)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/clang-debug/MiniEditor.exe",
      "cwd": "${workspaceFolder}/build/clang-debug",
      "preLaunchTask": "CMake: Build MiniEditor Debug",
      "stopOnEntry": false,
      "terminal": "integrated",
      "sourceLanguages": [
        "cpp"
      ]
    },
    {
      "name": "Run MiniEditor Release",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/clang-release/MiniEditor.exe",
      "cwd": "${workspaceFolder}/build/clang-release",
      "preLaunchTask": "CMake: Build MiniEditor Release",
      "stopOnEntry": false,
      "terminal": "integrated",
      "sourceLanguages": [
        "cpp"
      ]
    }
  ]
}
